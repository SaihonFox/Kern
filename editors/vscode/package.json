{
	"name": "kern-language",
	"displayName": "Kern Language",
	"description": "Kern language support through the bundled kernc LSP server.",
	"version": "0.1.0",
	"publisher": "kern",
	"repository": {
		"type": "git",
		"url": "https://github.com/SaihonFox/Kern.git"
	},
	"homepage": "https://github.com/SaihonFox/Kern",
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Programming Languages"
	],
	"activationEvents": [
		"onLanguage:kern"
	],
	"main": "./extension.js",
	"contributes": {
		"languages": [
			{
				"id": "kern",
				"aliases": [
					"Kern",
					"kern"
				],
				"extensions": [
					".kern"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "kern",
				"scopeName": "source.kern",
				"path": "./syntaxes/kern.tmLanguage.json"
			}
		],
		"configuration": {
			"title": "Kern",
			"properties": {
				"kern.lsp.command": {
					"type": "string",
					"default": "",
					"description": "Команда запуска сервера. Пусто — найти собранный kernc в репозитории автоматически; иначе укажите kernc или полный путь."
				},
				"kern.lsp.args": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"lsp"
					],
					"description": "Аргументы команды сервера (по умолчанию: lsp)."
				}
			}
		}
	},
	"dependencies": {
		"vscode-languageclient": "^9.0.1"
	}
}
