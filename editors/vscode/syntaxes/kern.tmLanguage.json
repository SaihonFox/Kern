{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Kern",
	"scopeName": "source.kern",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#attributes"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#chars"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#declarations"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#types"
		},
		{
			"include": "#constants"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#punctuation"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.documentation.kern",
					"match": "///.*$"
				},
				{
					"name": "comment.line.double-slash.kern",
					"match": "//.*$"
				},
				{
					"name": "comment.block.kern",
					"begin": "/\\*",
					"end": "\\*/"
				}
			]
		},
		"attributes": {
			"patterns": [
				{
					"name": "meta.attribute.kern",
					"begin": "#\\[",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.attribute.begin.kern"
						}
					},
					"end": "\\]",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.attribute.end.kern"
						}
					},
					"patterns": [
						{
							"include": "#strings"
						},
						{
							"name": "entity.other.attribute-name.kern",
							"match": "[A-Za-z_][A-Za-z0-9_]*"
						},
						{
							"include": "#numbers"
						}
					]
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.triple.kern",
					"begin": "(?<![A-Za-z0-9_])(?:[rfxv]{1,4})?\"\"\"",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.string.begin.kern"
						}
					},
					"end": "\"\"\"",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.string.end.kern"
						}
					},
					"patterns": [
						{
							"include": "#interpolation"
						}
					]
				},
				{
					"name": "string.quoted.double.kern",
					"begin": "(?<![A-Za-z0-9_])(?:[rfxv]{1,4})?\"",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.string.begin.kern"
						}
					},
					"end": "\"",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.string.end.kern"
						}
					},
					"patterns": [
						{
							"include": "#interpolation"
						},
						{
							"name": "constant.character.escape.kern",
							"match": "\\\\.",
							"comment": "В raw-строках обратный слэш буквальный; подсветка не различает префикс."
						}
					]
				}
			]
		},
		"interpolation": {
			"patterns": [
				{
					"name": "meta.interpolation.kern",
					"begin": "\\$\\{",
					"beginCaptures": {
						"0": {
							"name": "punctuation.section.interpolation.begin.kern"
						}
					},
					"end": "\\}",
					"endCaptures": {
						"0": {
							"name": "punctuation.section.interpolation.end.kern"
						}
					},
					"patterns": [
						{
							"include": "source.kern"
						}
					]
				}
			]
		},
		"chars": {
			"patterns": [
				{
					"name": "string.quoted.single.kern",
					"match": "'(?:\\\\.|[^'\\\\])'"
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.hex.kern",
					"match": "\\b0[xX][0-9a-fA-F_]+(?:[iu](?:8|16|32|64)|u8)?\\b"
				},
				{
					"name": "constant.numeric.binary.kern",
					"match": "\\b0[bB][01_]+(?:[iu](?:8|16|32|64)|u8)?\\b"
				},
				{
					"name": "constant.numeric.octal.kern",
					"match": "\\b0[hH][0-7_]+(?:[iu](?:8|16|32|64)|u8)?\\b"
				},
				{
					"name": "constant.numeric.float.kern",
					"match": "\\b(?:\\d[\\d_]*\\.\\d[\\d_]*|\\.\\d[\\d_]*)(?:[eE][+-]?[\\d_]+)?(?:f16|f32|f64)?\\b"
				},
				{
					"name": "constant.numeric.float.kern",
					"match": "\\b\\d[\\d_]*[eE][+-]?[\\d_]+(?:f16|f32|f64)?\\b"
				},
				{
					"name": "constant.numeric.integer.kern",
					"match": "\\b\\d[\\d_]*(?:[iu](?:8|16|32|64)|u8)?\\b"
				}
			]
		},
		"declarations": {
			"patterns": [
				{
					"match": "\\b(fun)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\.([A-Za-z_][A-Za-z0-9_]*))?",
					"captures": {
						"1": {
							"name": "keyword.declaration.function.kern"
						},
						"2": {
							"name": "entity.name.type.kern"
						},
						"3": {
							"name": "entity.name.function.kern"
						}
					}
				},
				{
					"match": "\\b(type|unit)\\s+([A-Za-z_][A-Za-z0-9_]*)",
					"captures": {
						"1": {
							"name": "keyword.declaration.type.kern"
						},
						"2": {
							"name": "entity.name.type.kern"
						}
					}
				},
				{
					"match": "\\b(ctor|op)\\b",
					"name": "keyword.declaration.kern"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.kern",
					"match": "\\b(if|else|loop|match|is|in|ret|stop|next|yield|await|async|use|project)\\b|!is\\b|!in\\b"
				},
				{
					"name": "keyword.modifier.kern",
					"match": "\\b(pub|priv|internal|protected|open|static|override|abstract|test|const)\\b"
				},
				{
					"name": "keyword.other.kern",
					"match": "\\b(fun|type|unit|var|ctor|op)\\b"
				},
				{
					"name": "variable.language.self.kern",
					"match": "\\$(?:\\[[A-Za-z_][A-Za-z0-9_]*\\])?"
				}
			]
		},
		"types": {
			"patterns": [
				{
					"name": "support.type.primitive.kern",
					"match": "\\b(?:i8|i16|i32|i64|u8|u16|u32|u64|f16|f32|f64|bool|char|str|void|object|never|never|inum|fnum|num)\\b"
				},
				{
					"name": "support.type.builtin.kern",
					"match": "\\b(?:list|array|dict|set|queue|stack|result|task|seq|span|collection|observable|async_iter|iter|frozen_list|frozen_dict|frozen_set|lazy|deque|priority_queue|sorted_dict|sorted_set|bitset|ring_buffer)\\b"
				}
			]
		},
		"constants": {
			"patterns": [
				{
					"name": "constant.language.kern",
					"match": "\\b(?:true|false|nil|none)\\b"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.kern",
					"match": "===|!==|==|!=|<=|>=|&&|\\|\\||\\*\\*|<<=|>>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|\\.\\.=|\\.\\.|\\?\\?|\\?\\?=|\\?\\.|\\?:|->|=>|[-+*/%<>=!&|^~]"
				}
			]
		},
		"punctuation": {
			"patterns": [
				{
					"name": "punctuation.separator.kern",
					"match": "[,.\\[\\]{}():;]"
				}
			]
		}
	}
}
