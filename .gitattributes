# Проект использует CRLF во всех текстовых файлах (AGENTS.md, tools/check-style.mjs).
# Git хранит LF в индексе, а на checkout отдаёт CRLF на всех платформах,
# иначе Linux CI видит LF и падает на проверке стиля.
* text=auto eol=crlf

# Бинарные файлы не трогаем.
*.7z binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.dll binary
*.exe binary
*.kbc binary
*.db binary
