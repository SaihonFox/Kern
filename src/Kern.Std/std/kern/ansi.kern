// kern.ansi — версия на Kern (пилот Kern.Std).
// Чистые строковые функции; цвета не включаются при перенаправлении вывода —
// это делает вызывающая сторона через ansi.supports().
project kern.ansi:
use kern.test[assert_eq]

pub fun escape(str code) -> str "\u001b[" + code + "m"

pub fun wrap(str code, str text) -> str escape(code) + text + escape("0")

pub fun red(str text) -> str wrap("31", text)
pub fun green(str text) -> str wrap("32", text)
pub fun yellow(str text) -> str wrap("33", text)
pub fun blue(str text) -> str wrap("34", text)
pub fun magenta(str text) -> str wrap("35", text)
pub fun cyan(str text) -> str wrap("36", text)
pub fun white(str text) -> str wrap("37", text)
pub fun bold(str text) -> str wrap("1", text)
pub fun dim(str text) -> str wrap("2", text)
pub fun italic(str text) -> str wrap("3", text)
pub fun underline(str text) -> str wrap("4", text)
pub fun reset() -> str escape("0")

pub fun color256(i32 code, str text) -> str wrap("38;5;" + code.to_str(), text)

pub fun rgb(i32 red, i32 green, i32 blue, str text) -> str
	wrap("38;2;" + red.to_str() + ";" + green.to_str() + ";" + blue.to_str(), text)

// Удалить ANSI escape-последовательности вида ESC[...m.
pub fun strip(str text) -> str {
	var builder = string_builder()
	i32 index = 0
	loop index < text.len {
		char current = text[index]
		if current.code == 27 {
			index += 1
			loop index < text.len && text[index] != 'm' {
				index += 1
			}
			if index < text.len {
				index += 1
			}
			next
		}
		builder.append(current)
		index += 1
	}
	builder.to_str()
}

// Терминал обычно определяется окружением; по умолчанию считаем ANSI доступным.
pub fun supports() -> bool true

#[test]
pub fun wraps_and_strips() {
	assert_eq("x", strip(red("x")))
	assert_eq("\u001b[31mx\u001b[0m", red("x"))
	assert_eq(2, strip("a" + color256(196, "b")).len)
}
