// Низкоуровневые помощники парсера: состояние, токены, типы и балансировка скобок.
use tokens[token]
use ast[parse_error]

type parser_state(list<token> tokens, i32 position, list<parse_error> errors)

fun peek(parser_state p) -> token {
	if p.position >= p.tokens.len {
		i32 line = 1
		i32 column = 1
		if p.tokens.len > 0 {
			line = p.tokens[p.tokens.len - 1].line
			column = p.tokens[p.tokens.len - 1].column
		}
		ret token("eof", "", line, column)
	}
	p.tokens[p.position]
}

fun at(parser_state p, str text) -> bool peek(p).text == text

fun at_eof(parser_state p) -> bool peek(p).kind == "eof"

fun advance(parser_state p) -> token {
	token current = peek(p)
	if p.position < p.tokens.len {
		p.position += 1
	}
	current
}

fun expect(parser_state p, str text) -> token {
	token current = peek(p)
	if current.text != text {
		error_at(p, "ожидалось '" + text + "'", current)
		if current.kind != "eof" {
			_ = advance(p)
		}
		ret current
	}
	advance(p)
}

fun expect_ident(parser_state p) -> token {
	token current = peek(p)
	if current.kind != "ident" || is_keyword(current.text) {
		error_at(p, "ожидалось имя", current)
		if current.kind != "eof" {
			_ = advance(p)
		}
		ret current
	}
	advance(p)
}

fun error_at(parser_state p, str message, token place) {
	p.errors.add(parse_error(message, place.line, place.column))
}

fun is_keyword(str text) -> bool
	text == "fun" || text == "type" || text == "unit" || text == "use" ||
	text == "ret" || text == "if" || text == "else" || text == "loop" ||
	text == "stop" || text == "next" || text == "match" || text == "var" ||
	text == "op" || text == "async" || text == "await" || text == "in" ||
	text == "is" || text == "true" || text == "false" || text == "nil" ||
	text == "none"

fun is_decl_start(str text) -> bool
	text == "fun" || text == "type" || text == "unit" || text == "use" || text == "#"

fun parse_attributes(parser_state p) -> list<str> {
	list<str> result = []
	loop (at(p, "#")) {
		_ = advance(p)
		if (at(p, "[") == false) {
			error_at(p, "ожидалось '[' после '#'", peek(p))
			stop
		}
		str raw = consume_balanced(p, "[", "]")
		if raw.len >= 2 {
			result.add(raw[1..(raw.len - 1)])
		} else {
			result.add("")
		}
	}
	result
}

fun consume_balanced(parser_state p, str opening, str closing) -> str {
	str result = ""
	i32 depth = 0
	if (at(p, opening)) {
		result += advance(p).text
		depth = 1
	}
	loop depth > 0 && at_eof(p) == false {
		token current = advance(p)
		result += current.text
		if current.text == opening {
			depth += 1
		} else if current.text == closing {
			depth -= 1
		}
	}
	result
}

fun consume_until_decl(parser_state p) -> str {
	str result = ""
	i32 depth = 0
	loop (at_eof(p) == false) {
		token current = peek(p)
		if depth == 0 && is_decl_start(current.text) {
			stop
		}
		if current.text == "[" || current.text == "(" || current.text == "{" || current.text == "<" {
			depth += 1
		} else if current.text == "]" || current.text == ")" || current.text == "}" || current.text == ">" {
			if depth > 0 {
				depth -= 1
			}
		}
		result += current.text
		_ = advance(p)
	}
	result
}

fun consume_until(parser_state p, str stopText) -> str {
	str result = ""
	i32 depth = 0
	loop (at_eof(p) == false) {
		token current = peek(p)
		if depth == 0 && current.text == stopText {
			stop
		}
		if current.text == "[" || current.text == "(" || current.text == "{" || current.text == "<" {
			depth += 1
		} else if current.text == "]" || current.text == ")" || current.text == "}" || current.text == ">" {
			if depth > 0 {
				depth -= 1
			}
		}
		if result.len > 0 {
			result += " "
		}
		result += current.text
		_ = advance(p)
	}
	result
}


fun parse_type(parser_state p) -> str {
	str result = ""
	if (at(p, "&")) || at(p, "*") {
		result += advance(p).text
	}
	if (peek(p).text == "fun") {
		result += advance(p).text
		if (at(p, "(")) {
			result += consume_balanced(p, "(", ")")
		}
		if (at(p, "->")) {
			_ = advance(p)
			result += "->" + parse_type(p)
		}
		ret result
	}
	if (at(p, "(")) {
		result += consume_balanced(p, "(", ")")
	} else if (peek(p).kind == "ident") {
		result += advance(p).text
	} else {
		error_at(p, "ожидался тип", peek(p))
		if (at_eof(p) == false) {
			_ = advance(p)
		}
		ret result
	}
	if (at(p, "<")) {
		result += consume_balanced(p, "<", ">")
	}
	loop (at(p, "[")) && p.position + 1 < p.tokens.len && p.tokens[p.position + 1].text == "]" {
		result += advance(p).text
		result += advance(p).text
	}
	if (at(p, "?")) {
		result += advance(p).text
	}
	result
}

fun same_line(parser_state p) -> bool {
	if p.position == 0 || p.position >= p.tokens.len {
		ret true
	}
	p.tokens[p.position].line == p.tokens[p.position - 1].line
}
