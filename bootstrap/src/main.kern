use tokens[token]
use lexer[lex]

// Демонстрация первого среза: печатает токены файла (или встроенного примера).
#[needs(fs.read("."))]
fun main(list<str> args) {
	str source = "fun main { }\n"
	if args.len > 0 {
		match file.read_text(args[0]) {
			Ok(value) => { source = value }
			Err(message) => {
				println(message)
				ret
			}
		}
	}

	list<token> tokens = lex(source)
	loop var item in tokens {
		println(f"${item.kind} '${item.text}' ${item.line}:${item.column}")
	}
}
