use tokens[token]
use lexer[lex]
use ast[ast_decl, ast_node, parse_error, parse_result, dump_program]
use parser[parse_source]

// Демонстрация среза B1: печатает AST файла (или встроенного примера).
#[needs(fs.read("."))]
fun main(list<str> args) {
	str source = "fun main { }\n"
	if args.len > 0 {
		match file.read_text(args[0]) {
			Ok(value) => { source = value }
			Err(message) => {
				println(message)
				ret
			}
		}
	}

	parse_result result = parse_source(source)
	if (result.ok == false) {
		loop var problem in result.errors {
			println(f"${problem.line}:${problem.column}: ${problem.message}")
		}
		ret
	}
	println(dump_program(result.program))
}
