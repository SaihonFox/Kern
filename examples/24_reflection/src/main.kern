// Раунд 18: рефлексия во время выполнения (Kotlin: свойства/`get`, C#: GetMethod/CreateInstance).
use kern.reflection[reflect]

#[entity("users")]
type User(str name, i32 age) {
	#[column("mail")]
	str email = ""

	fun greet(str who) -> str {
		ret f"Привет, ${who}, я ${name}"
	}
}

fun main {
	var t = typeof<User>()
	println(t.name)

	// Kotlin-стиль: перебор свойств и чтение через объект
	var u = User("Ян", 30)
	loop var f in t.fields {
		println(f"${f.name}: ${f.type.name} = ${f.get(u)}")
	}

	// атрибуты типа и полей
	if t.has_attribute("entity") {
		println(f"таблица: ${t.attribute("entity")?.args[0]}")
	}

	// C#-стиль: найти метод и вызвать
	var m = t.get_method("greet")
	if m != nil {
		println(m.call(u, ["мир"]))
	}

	// создание экземпляра по типу
	var v = t.create(["Аня", 25])
	println(t.get(v, "name"))

	// --- создание типа во время выполнения ---
	var builder = reflect.define_type("Point3").as_unit()
	builder = builder.field("x", f64).field("y", f64).field("z", f64)
	var p3 = builder.build()
	var pt = p3.create([1.0, 2.0, 3.0])
	println(pt)
	println(f"${p3.name}: ${p3.fields.len} поля, z = ${p3.get(pt, "z")}")

	// --- рефлексия во время компиляции: значения вычисляются компилятором ---
	println(name_of<User>())               // User
	println(field_names<User>())           // [name, age, email]
	println(has_attribute<User>("entity")) // true
	println(attribute_names<User>())       // [entity]

	// поиск по модулю
	loop var e in reflect.types_with_attribute("entity") {
		println(f"entity: ${e.name}")
	}
}
