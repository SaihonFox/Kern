// Тесты запускаются командой: kernc test examples/10_testing
use kern.test[assert, assert_eq, assert_near]
use math_utils[clamp, factorial]

fun main {
	println(factorial(10))
}

#[test]
fun clamp_works {
	assert_eq(5, clamp(5, 0, 10))
	assert_eq(0, clamp(-3, 0, 10))
	assert_eq(10, clamp(99, 0, 10))
}

#[test]
fun factorial_works {
	assert_eq(1, factorial(0))
	assert_eq(3628800, factorial(10))
}

#[test]
fun floats_are_close {
	assert_near(0.3, 0.1 + 0.2)
}
