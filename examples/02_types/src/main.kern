// Коллекции, кортежи, деструктуризация, union-типы, in / is
type id_value = [i32, str]

fun describe(id_value id) -> str
	match id { str s => f"строка ${s}"; i32 n => f"число ${n}" }

fun min_max(list<i32> xs) -> (i32 lo, i32 hi) {
	i32 lo = xs[0]
	i32 hi = xs[0]
	loop var v in xs {
		if v < lo { lo = v }
		if v > hi { hi = v }
	}
	(lo, hi)
}

fun main {
	list<i32> nums = [3, 1, 4, 1, 5, 9, 2, 6]
	array<i32> fixed = array<i32>[1, 2, 3]
	dict<str, i32> ages = ["аня": 25, "борис": 31]
	var empty = <i32>[]
	var table = <str: bool>[]

	println(nums)
	println(fixed)
	println(ages)
	println(5 in nums)
	println(7 !in nums)

	// кортежи
	(i32, str) pair = (10, "hello")
	(i32 n, str s) = pair
	println(f"${n} ${s}")
	(i32 x, i32 y) point = (3, 4)
	println(point.x + point.y)

	// деструктуризация коллекций
	(i32 first, list<i32> ..rest, _) = nums
	println(f"first=${first}, rest=${rest}")

	// union
	println(describe(5))
	println(describe("abc"))

	id_value v = "qwe"
	println(v is str)
	println(v !is i32)

	// повышение числовых типов при выводе
	var mixed = [1, 2i64, 3]          // list<i64>
	println(mixed)
}
